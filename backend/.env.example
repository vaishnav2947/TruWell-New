DATABASE_URL=postgresql://user:password@localhost:5432/truwell?schema=public
JWT_SECRET=your-super-secret-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-secret-change-this-in-production
JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@truwell.com
# Admin credentials (for initial setup)
ADMIN_EMAIL=admin@truwell.com
ADMIN_PASSWORD=Admin123!
# Other service credentials
REDIS_URL=redis://localhost:6379
# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890